import re
1. Define the regex pattern for the log line format
Format: IP - - [timestamp] "METHOD PATH HTTP/VER" STATUS SIZE ...
LOG_PATTERN =3D r'^(\S+) \S+ \S+ [([\w:/]+ +\d{4})] "(\S+) (\S+) \S+" (\d{3=
}) (\d+|-)'
2. Initialize an accumulator to count invalid lines
invalid_count_acc =3D sc.accumulator(0)
def parse_log_line(line):
match =3D re.search(LOG_PATTERN, line)
if not match:
# Increment the accumulator for malformed lines
invalid_count_acc.add(1)
return None
ip =3D match.group(1)
timestamp =3D match.group(2)
method =3D match.group(3)
path =3D match.group(4)
status =3D int(match.group(5))
# Handle missing/unknown byte size ("-")
raw_bytes =3D match.group(6)
bytes_sent =3D None if raw_bytes =3D=3D '-' else int(raw_bytes)
return (ip, timestamp, method, path, status, bytes_sent)
3. Load raw access log file into an RDD
raw_rdd =3D sc.textFile("access.log")
4. Parse the log lines and filter out invalid ones (None)
parsed_rdd =3D raw_rdd.map(parse_log_line).filter(lambda record: record is =
not None)
Cache the parsed RDD since subsequent stages build upon it
parsed_rdd.cache()
Trigger an action to process the RDD and evaluate accumulator
valid_records_count =3D parsed_rdd.count()

Save counts to the specific variable names expected by check()
n_parsed =3D parsed_rdd.count()
n_bad =3D invalid_count_acc.value
print(f"Valid records processed: {n_parsed}")
print(f"Invalid records count (Accumulator): {n_bad}")

